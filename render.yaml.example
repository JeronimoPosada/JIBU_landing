# Ejemplo de configuración para Render (plantilla)
# Ajusta los valores según tu proyecto y la UI de Render.

# === Opción A: Static Site (recomendada) ===
# Deploy estático: Render servirá los archivos generados en `dist/`.
# - Build Command: `npm ci && npm run build`
# - Start Command: (no necesario para sites estáticos)

services:
  - type: static
    name: jibu-landing-static
    repo: https://github.com/JIBU-co/JIBU_landing.git
    branch: main
    buildCommand: npm ci && npm run build
    staticPublishPath: dist

# === Opción B: Web Service (Node SSR) ===
# Si prefieres ejecutar el bundle server (SSR), usa un servicio web Node.
# Asegúrate de ajustar `startCommand` según la ubicación del entry server en `dist/`.

# services:
#   - type: web
#     name: jibu-landing-ssr
#     repo: https://github.com/JIBU-co/JIBU_landing.git
#     branch: main
#     buildCommand: npm ci && npm run build
#     startCommand: node dist/server/server.js

# Nota: Render puede cambiar la sintaxis de `render.yaml`. Usa este archivo
# como plantilla para copiar/pegar en la UI de Render o como referencia.